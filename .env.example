# ── daily-data-sync  Environment Variables ──────────────────────
# Copy this file to .env and edit the values.

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Number of top coins to fetch (max 250)
COINS_PER_PAGE=25

# Target fiat currency for prices
VS_CURRENCY=usd

# Local data output directory (relative to project root)
DATA_DIR=data

# ── Optional: AWS S3 Upload ─────────────────────────────────────
# AWS_S3_BUCKET=my-bucket-name
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=us-east-1
